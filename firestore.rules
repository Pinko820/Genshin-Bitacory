rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/characters/{characterId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.data.id == characterId
        && request.resource.data.data.nombre is string
        && request.resource.data.data.nombre.size() > 0
        && request.resource.data.data.nombre.size() <= 100
        && request.resource.data.updatedAt == request.time;
    }
  }
}
